# 复制本文件为 .env 后填写真实值；.env 不会进仓库。

# 运行环境
NODE_ENV=development
PORT=3000

# MySQL（使用专用账号 myblog_app，只授权 myblog 库）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=myblog_app
DB_NAME=myblog
DB_PASSWORD=

# 连接池上限：常驻服务用 10；Serverless 部署（如 EdgeOne）调到 2–3
DB_POOL_SIZE=10
# 云数据库一般要求加密连接，线上置为 true
DB_SSL=false

# JWT
# 至少 32 个字符；可用以下命令生成：
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
